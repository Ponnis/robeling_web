@article{10.1093/mnras/stag1951,
    author = {Boro Saikia, Sudeshna and Tennyson, Jonathan and Ji, Shuchen and Robeling, Nils-Martin and Stanković, Ivan and Van Looveren, Gwenaëlle and Schleich, Simon and Johnstone, Colin P and Kislyakova, Kristina G and Güdel, Manuel},
    title = {The physical and chemical structure of Titan’s upper atmosphere: energy balance, photochemistry, and Jeans escape},
    journal = {Monthly Notices of the Royal Astronomical Society},
    volume = {553},
    number = {1},
    pages = {stag1951},
    year = {2026},
    month = {11},
    abstract = {Titan’s upper atmospheric layers provide a unique opportunity to study how photochemistry, photoionization, haze microphysics, and escape processes shape its atmospheric chemical structure, providing a unique benchmark for understanding these processes in exoplanets. Using a 1D first-principles approach, we extend the Kompot model to simulate Titan’s upper atmosphere and investigate its thermal and chemical structure, and Jeans escape. We performed self-consistent simulations of Titan’s upper atmosphere, above the dense haze layer, over a 1D radial grid by solving the coupled hydrodynamics, thermal and photochemical kinetic, and energy balance equations. We considered heating by stellar X-ray and ultraviolet (XUV) and infrared radiation, and cooling due to radiative emission of methane (\$\\text\{CH\}\_\{4\}\$) and hydrogen cyanide (\$\\text\{HCN\}\$). We also included additional 19 photochemical and 117 thermal reactions to Kompot’s standard chemical network. Our modelled atmospheric temperature structures lie within the observed variability of Titan’s atmospheric temperature profile. Our simulations reproduce observed nitrogen (\$\\text\{N\}\_\{2\}\$) and \$\\text\{CH\}\_\{4\}\$ densities in the upper atmosphere, and abundance of minor chemical species also broadly agree with observationally derived abundances. Near the exobase, our \$\\text\{CH\}\_\{4\}\$ mixing ratio overlaps with Cassini–Huygens results, and our model \$\\text\{H\}\_\{2\}\$ mixing ratios also exhibit broad agreement with observations. Our simulations suggest no significant thermal loss of \$\\text\{CH\}\_\{4\}\$, even under the conditions of an early Sun’s XUV environment.},
    issn = {0035-8711},
    doi = {10.1093/mnras/stag1951},
    url = {https://doi.org/10.1093/mnras/stag1951},
    eprint = {https://academic.oup.com/mnras/article-pdf/553/1/stag1951/71948412/stag1951.pdf},
    authorship = {co},
}


